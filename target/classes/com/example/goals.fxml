<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.GoalsController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <HBox alignment="CENTER_LEFT">
        <Label text="Goals" styleClass="header-label"/>
    </HBox>

    <ListView fx:id="goalsListView" VBox.vgrow="ALWAYS" />

    <HBox>
        <Button text="❮" styleClass="icon-button" onAction="#switchToPrimary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+" styleClass="plus-button" style="-fx-font-size: 30px;" onAction="#switchToCreateGoal"/>
    </HBox>
</VBox>
