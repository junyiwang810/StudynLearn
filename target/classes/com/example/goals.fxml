<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.GoalsController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button text="← Back" styleClass="icon-button" onAction="#switchToPrimary"/>
        <Label text="Goals" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Add Goal" styleClass="primary-button" onAction="#switchToCreateGoal"/>
    </HBox>
    <Label text="Choose a main goal and keep your list tidy." styleClass="page-subtitle"/>

    <ListView fx:id="goalsListView" VBox.vgrow="ALWAYS" />
</VBox>
