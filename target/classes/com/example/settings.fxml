<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<VBox spacing="30.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.SettingsController">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    
    <Label text="Settings" styleClass="header-label"/>
    
    <VBox spacing="20" alignment="CENTER">
        <Label text="Hourly rate" styleClass="sub-header-label"/>
        <TextField fx:id="hourlyRateField" alignment="CENTER" maxWidth="150"/>
        
        <Label text="Current Bank balance" styleClass="sub-header-label"/>
        <TextField fx:id="balanceField" alignment="CENTER" maxWidth="150"/>
    </VBox>
    
    <Region VBox.vgrow="ALWAYS"/>
    
    <HBox>
        <Button text="❮" styleClass="icon-button" onAction="#saveAndBack"/> 
    </HBox>
</VBox>