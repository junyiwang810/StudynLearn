<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="30.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.SettingsController">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    
    <HBox alignment="CENTER_LEFT">
        <Button text="← Back" styleClass="icon-button" onAction="#saveAndBack"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Settings" styleClass="page-title"/>
    </HBox>
    <Label text="Update your hourly rate and current balance." styleClass="page-subtitle"/>
    
    <VBox spacing="20" alignment="CENTER_LEFT">
        <Label text="Hourly Rate" styleClass="sub-header-label"/>
        <TextField fx:id="hourlyRateField" alignment="CENTER" maxWidth="150"/>
        
        <Label text="Current Balance" styleClass="sub-header-label"/>
        <TextField fx:id="balanceField" alignment="CENTER" maxWidth="150"/>

        <Label text="Calculated Study Hourly Rate" styleClass="sub-header-label"/>
        <Label fx:id="studyRateLabel" styleClass="page-title" text="\$0.00 / hr"/>
    </VBox>
    
    <Region VBox.vgrow="ALWAYS"/>
    
    <HBox alignment="CENTER_RIGHT">
        <Button text="Save and Back" styleClass="primary-button" onAction="#saveAndBack"/> 
    </HBox>
</VBox>
