<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.PrimaryController">
    <top>
        <VBox spacing="6">
            <padding><Insets top="20" right="20" bottom="8" left="20"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Home" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Manage Goals" styleClass="secondary-button" onAction="#switchToGoals"/>
            </HBox>
            <Label text="Choose what you want to do next." styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="12">
            <Button text="Start Study Session" styleClass="primary-button" onAction="#switchToStudying"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="BOTTOM_LEFT" spacing="12">
            <padding><Insets top="14" right="20" bottom="20" left="20"/></padding>
            <Button text="Settings" styleClass="icon-button" onAction="#switchToSettings"/>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="BOTTOM_RIGHT" spacing="4">
                <Label fx:id="goalNameLabel" text="No Main Goal" styleClass="sub-header-label"/>
                <Label fx:id="percentageLabel" text="0% Complete" styleClass="page-title"/>
                <Label fx:id="fractionLabel" text="\$0.00 / \$0.00" styleClass="page-subtitle"/>
            </VBox>
        </HBox>
    </bottom>
</BorderPane>
