<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ListView?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.SettingsController">
    <children>
        <Label text="Settings View" />
        <Label text="Hourly Rate ($/hr)" />
        <TextField fx:id="hourlyRateField" promptText="e.g. 15.0" maxWidth="200.0" />
        <Label text="Current Bank Balance ($)" />
        <TextField fx:id="balanceField" promptText="e.g. 50.0" maxWidth="200.0" />
        <Label text="Blocked Websites" />
        <HBox alignment="CENTER" spacing="10.0">
            <TextField fx:id="newBlockedSiteField" promptText="e.g. youtube.com" />
            <Button onAction="#addBlockedSite" text="Add" />
        </HBox>
        <ListView fx:id="blockedSitesListView" prefHeight="150.0" maxWidth="300.0" />
        <Button onAction="#removeBlockedSite" text="Remove Selected" />
        <Button onAction="#saveSettings" text="Save Settings" />
        <Button onAction="#switchToPrimary" text="Back to Home" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>