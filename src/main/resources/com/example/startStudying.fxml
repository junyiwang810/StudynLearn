<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.StartStudyingController">
    <top>
        <VBox spacing="6">
            <padding><Insets top="20" right="20" bottom="10" left="20" /></padding>
            <HBox alignment="CENTER_LEFT">
                <Button onAction="#switchToPrimary" styleClass="icon-button" text="← Back" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Study Setup" styleClass="page-title" />
            </HBox>
            <Label styleClass="page-subtitle" text="Step 1: Session length  •  Step 2: Break  •  Step 3: Repeats" />
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="24">
            <VBox alignment="CENTER" spacing="15">
                <Label styleClass="sub-header-label" text="Select Session Length" />
                <HBox alignment="CENTER" spacing="15">
                    <Button onAction="#handleDuration" styleClass="chip-button" text="25 min" />
                    <Button onAction="#handleDuration" styleClass="chip-button" text="50 min" />
                    <Button onAction="#handleDuration" styleClass="chip-button" text="90 min" />
                </HBox>
            </VBox>

            <VBox alignment="CENTER" spacing="15">
                <Label styleClass="sub-header-label" text="Select Break Length" />
                <HBox alignment="CENTER" spacing="15">
                    <Button onAction="#handleBreak" styleClass="chip-button" text="5 min" />
                    <Button onAction="#handleBreak" styleClass="chip-button" text="10 min" />
                    <Button onAction="#handleBreak" styleClass="chip-button" text="15 min" />
                </HBox>
            </VBox>

            <VBox alignment="CENTER" spacing="15">
                <Label styleClass="sub-header-label" text="Select Repeats" />
                <HBox alignment="CENTER" spacing="15">
                    <Button onAction="#handleSessions" styleClass="chip-button" text="1" />
                    <Button onAction="#handleSessions" styleClass="chip-button" text="2" />
                    <Button onAction="#handleSessions" styleClass="chip-button" text="3" />
                    <Button onAction="#handleSessions" styleClass="chip-button" text="4" />
                </HBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding><Insets top="10" right="20" bottom="22" left="20"/></padding>
            <Button fx:id="startTimerButton" disable="true" onAction="#startTimer" styleClass="primary-button" text="Start Timer" />
        </HBox>
    </bottom>
</BorderPane>
